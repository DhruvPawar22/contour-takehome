# Vercel backend env vars — set these in the Vercel dashboard, never commit real values.
FIREBASE_SERVICE_ACCOUNT_KEY=
ROSTER_API_KEY=
GEMINI_API_KEY=
INGEST_WEBHOOK_SECRET=
# Must be named exactly CRON_SECRET — Vercel auto-authorizes cron invocations of /api/roster/sync
# with this value as a Bearer token when the env var has this exact name.
CRON_SECRET=

# Local dev only — not deployed to Vercel. Password for the seeded test accounts created by
# scripts/seed-test-accounts.js (one per role: lead/coordinator/tutor).
TEST_ACCOUNT_PASSWORD=
